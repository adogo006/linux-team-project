{
  "name": "linux-team-project-devcontainer",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "api", // 여기서 본인이 vscode에서 개발할 컨테이너 선택
  "runServices": ["db", "nginx", "api"], // 다른 컨테이너들은 백그라운드로 실행
  "workspaceFolder": "/workspaces",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:1": {
      "configureZshAsDefaultShell": true
    }, // 공통 유틸리티 
    "ghcr.io/devcontainers/features/git:1": "latest", // Git 설치
    "ghcr.io/devcontainers/features/node:1": {
        "version": "latest"
    }, // Node.js 설치
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
        "version": "latest", //docker 설치
        "moby": false
    } // Docker 설치 및 호스트의 Docker 데몬 사용
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.isort",
        "ms-python.black-formatter",  // Python 코드 에디터 확장
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",    // PostgreSQL 지원
        "ms-azuretools.vscode-docker",// Docker 지원
        "humao.rest-client",          // API 테스트용 확장
        "njpwerner.autodocstring",    // 문서화 자동화
        "tamasfe.even-better-toml",   // TOML 설정 파일 지원
        "GitHub.copilot-chat",        // GitHub Copilot Chat 확장

        // 아래는 프론트엔드 개발에 유용한 확장들입니다. 필요에 따라 추가하거나 제거할 수 있습니다.
        "esbenp.prettier-vscode",      // 코드 포맷터
        "dbaeumer.vscode-eslint",       // ESLint 지원
        "bradlc.vscode-tailwindcss",   // Tailwind CSS 지원
        "formulahendry.auto-close-tag", // HTML 자동 태그 닫기
        "ms-vscode.live-server" // Live Server 확장 

        //이 아래서 vscode에서 사용할 확장 추가할 수 있습니다.
      ]
    }
  },
  "remoteUser": "root"
}